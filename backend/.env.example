# =============================================================================
# NexusHub Backend Environment Configuration Template
# Reference: nexus-engineering-guidelines.md (Non-Negotiable #6 — No secrets in git)
# =============================================================================

# Server Setup
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Supabase PostgreSQL Connection
# Transaction Pooler URL (Supavisor / PgBouncer port 6543)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# Direct Connection URL (port 5432) for DDL migrations
DIRECT_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Redis (ElastiCache / Local Redis for WebSocket Pub/Sub & Presence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (Auth0 / Keycloak OIDC)
AUTH0_DOMAIN=dev-nexushub.us.auth0.com
AUTH0_AUDIENCE=https://api.nexushub.io
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# AWS Cloud Infrastructure & Media Storage
AWS_REGION=us-east-1
AWS_S3_ATTACHMENTS_BUCKET=nexushub-attachments-dev
AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/your-kms-key-id

# AI & LLM Provider Keys (Phases 3+)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
